# OpenAI-compatible multimodal chat completions endpoint.
# The configured model must accept image_url inputs and return JSON.
PATENTAGENT_LLM_BASE_URL=https://api.openai.com/v1
PATENTAGENT_LLM_MODEL=
PATENTAGENT_LLM_API_KEY=
PATENTAGENT_LLM_TIMEOUT=180

# Existing Linux NVIDIA GPU server. Device 1 matches the previous deployment.
PATENTAGENT_DEVICE=cuda:1
PATENTAGENT_DATA_DIR=./data
PATENTAGENT_EXAMPLES_DIR=./examples
PATENTAGENT_MODEL_DIR=./models
PATENTAGENT_DPI=150

# auto uses float16 on NVIDIA, float32 on CPU (TITAN RTX has no native BF16).
PATENTAGENT_PRECISION=auto
PATENTAGENT_OCSR_BATCH_SIZE=8
PATENTAGENT_MARKUSH_BATCH_SIZE=4
PATENTAGENT_MARKUSH_MAX_NEW_TOKENS=1024

# Pinned model weights. Local OCSR .pth / Markush adapter / Qwen directories
# can replace the sources; revisions are then ignored and local files hashed.
# For custom HF repositories, also set the matching 40-character revision.
PATENTAGENT_OCSR_CHECKPOINT=EdisonScientific/OCSRGlyph
PATENTAGENT_OCSR_REVISION=da0d049fa56effd3a07ecb15c715efdd78d9e8a0
PATENTAGENT_MARKUSH_CHECKPOINT=EdisonScientific/MarkushGlyph
PATENTAGENT_MARKUSH_REVISION=2879b0380c2687a1bbdb2312ac4a810ed4887893
PATENTAGENT_MARKUSH_BASE_MODEL=Qwen/Qwen3.5-2B-Base
PATENTAGENT_MARKUSH_BASE_REVISION=b1485b2fa6dfa1287294f269f5fb618e03d52d7c
