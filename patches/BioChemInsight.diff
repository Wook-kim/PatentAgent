+def _extract_json_object(text):
+    if not text:
+        return None
+    if '```json' in text:
+        parts = text.split('```json', 1)
+        if len(parts) > 1:
+            return parts[1].split('```', 1)[0].strip()
+    if '```' in text and text.count('```') >= 2:
+        parts = text.split('```', 2)
+        if len(parts) >= 2:
+            return parts[1].strip()
+    start_brace = text.find('{')
+    end_brace = text.rfind('}')
+    if start_brace != -1 and end_brace != -1 and end_brace > start_brace:
+        return text[start_brace:end_brace + 1].strip()
+    return text.strip()
+
+
+def content_to_assay_metadata(content, assay_name, retry=3):
+    """Extract assay-level metadata from assay-page Markdown as JSON.
+
+    This complements content_to_dict(): it describes the assay context once,
+    while content_to_dict() extracts per-compound values.
+    """
+    LLM_MODEL_TYPE = 'openai'
+    if not LLM_TEXT_MODEL_KEY or not LLM_TEXT_MODEL_URL or not LLM_TEXT_MODEL_NAME:
+        LLM_MODEL_TYPE = 'gemini'
+
+    prompt = f'''Task
+Extract assay metadata for "{assay_name}" from the Markdown text.
+
+<MARKDOWN_TEXT>
+{content}
+</MARKDOWN_TEXT>
+
+Rules
+- Return only one JSON object.
+- Preserve short evidence snippets from the text when available.
+- Use null when unknown. Do not invent values.
+- assay_type should be one of IC50, EC50, Ki, Kd, GI50, MIC, pIC50, pEC50, or null.
+
+Output schema:
+{{
+  "assay_name": "{assay_name}",
+  "assay_type": null,
+  "target": null,
+  "cell_line": null,
+  "organism": null,
+  "readout": null,
+  "condition": null,
+  "unit": null,
+  "table_id": null,
+  "evidence_text": null
+}}'''
+
+    if LLM_MODEL_TYPE == 'gemini':
+        configure_genai(GEMINI_API_KEY_FOR_GEMINI_MODELS)
+        model = genai.GenerativeModel(DEFAULT_GEMINI_TEXT_MODEL_FOR_CONTENT_DICT)
+        response_text = "N/A"
+        for attempt in range(retry):
+            try:
+                response = model.generate_content(prompt)
+                response_text = response.candidates[0].content.parts[0].text
+                return json.loads(_extract_json_object(response_text))
+            except Exception as exc:
+                if attempt < retry - 1:
+                    time.sleep(1 + attempt)
+                    continue
+                print(f"Metadata extraction failed for {assay_name}: {exc}")
+                return {}
+
+    if LLM_MODEL_TYPE == 'openai':
+        client = OpenAI(api_key=LLM_TEXT_MODEL_KEY, base_url=LLM_TEXT_MODEL_URL)
+        for attempt in range(retry):
+            try:
+                response = client.chat.completions.create(
+                    model=LLM_TEXT_MODEL_NAME,
+                    messages=[
+                        {"role": "system", "content": "You output strict JSON only."},
+                        {"role": "user", "content": prompt},
+                    ],
+                    temperature=0.0,
+                )
+                text = response.choices[0].message.content or ""
+                if '<think>' in text and '</think>' in text:
+                    text = text[:text.index('<think>')] + text[text.index('</think>') + len('</think>'):]
+                return json.loads(_extract_json_object(text))
+            except Exception as exc:
+                if attempt < retry - 1:
+                    time.sleep(1 + attempt)
+                    continue
+                print(f"Metadata extraction failed for {assay_name}: {exc}")
+                return {}
+    return {}
